# Langfuse v3 self-host environment.
# Copy to .env and either fill in or run `./setup.sh` to bootstrap.
#
# NEVER commit the populated .env.

# ===== Public URL =====
# Full external URL Langfuse will be served at.
# Example (Tailscale Serve):  https://my-server.taila76294.ts.net:8443
# Example (Caddy / Cloudflare): https://langfuse.example.com
NEXTAUTH_URL=

# Host port that langfuse-web binds to (always loopback). Reverse-proxy this.
LANGFUSE_WEB_PORT=3000

# ===== Core secrets — set via setup.sh =====
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# ===== Auth policy =====
AUTH_DISABLE_SIGNUP=true
TELEMETRY_ENABLED=false

# ===== Bootstrap admin / project (optional) =====
# Set these to have Langfuse create the first org, project, user, and API
# keys on first startup. Keys must be pre-generated and follow the format
# pk-lf-XXXXX / sk-lf-XXXXX.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
